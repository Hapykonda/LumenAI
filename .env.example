# LumenAI environment contract.
# Never paste real secrets in this file. Configure real values in Vercel or .env.local.

# Public browser-safe values
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TRANSCRIPTION_MODEL=

# Server-only LumenAI keys by agent. Never expose these as NEXT_PUBLIC values.
GROQ_WIDGET_API_KEY=
GROQ_AUTOCONFIG_API_KEY=
GROQ_PANEL_API_KEY=
GROQ_RADAR_API_KEY=
GROQ_GROWTH_API_KEY=
GROQ_TWIN_API_KEY=
GROQ_CAMPAIGNS_API_KEY=

GROQ_WIDGET_MODEL=
GROQ_WIDGET_TRANSCRIPTION_MODEL=
GROQ_AUTOCONFIG_MODEL=
GROQ_PANEL_MODEL=
GROQ_RADAR_MODEL=
GROQ_GROWTH_MODEL=
GROQ_TWIN_MODEL=
GROQ_CAMPAIGNS_MODEL=

# Server-only Google Gmail draft integration. The encryption key must decode to
# exactly 32 bytes (base64) or contain 64 hexadecimal characters.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
LUMENAI_INTEGRATION_ENCRYPTION_KEY=

# Local development and smoke-test helpers
DEV_MAGICLINK_TOKEN=
LUMENAI_TEST_URL=
LUMENAI_TEST_PUBLIC_KEY=

